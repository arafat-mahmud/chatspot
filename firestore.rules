rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// This REPLACES the rules in the Firebase console. If you customized rules
// there, merge them into this file first.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == userId;
      // Others may update a profile (e.g. deleting a conversation clears the
      // friend's chatList entry) but never its push tokens.
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['fcmTokens']));
    }

    match /chats/{chatId} {
      allow read, write: if signedIn();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    match /friend_requests/{requestId} {
      allow read, write: if signedIn();
    }

    match /friendships/{friendshipId} {
      allow read, write: if signedIn();
    }

    match /calls/{callId} {
      // Each disjunct matches one query: the incoming-call listener filters
      // on calleeId, the Calls tab on participants.
      allow read: if signedIn() && (
        request.auth.uid == resource.data.calleeId ||
        request.auth.uid in resource.data.participants);

      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.participants ==
             [request.auth.uid, request.resource.data.calleeId]
        && request.resource.data.status == 'ringing';

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.participants == resource.data.participants;

      match /{candidateCollection}/{candidateId} {
        allow read, write: if signedIn()
          && candidateCollection in ['callerCandidates', 'calleeCandidates']
          && request.auth.uid in
               get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
    }
  }
}
