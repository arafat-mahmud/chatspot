rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// This REPLACES the rules in the Firebase console. If you customized rules
// there, merge them into this file first.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Profiles are public to signed-in users (search, chat headers).
      allow read: if signedIn();
      // Only the owner writes a profile. Copies of names and photos in
      // friendships and chats are updated by the owner (see ProfileService).
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Chat ids are the two user ids, sorted and joined by "-".
    function inChat(chatId) {
      return request.auth.uid in chatId.split('-');
    }

    match /chats/{chatId} {
      allow get, create, update, delete: if signedIn() && inChat(chatId);
      // Each disjunct matches one query: the chat list (participantIds) and
      // the one-time migration of older chats (participants map).
      allow list: if signedIn() && (
        request.auth.uid in resource.data.participantIds ||
        resource.data.participants[request.auth.uid] == true);

      match /messages/{messageId} {
        allow read, update, delete: if signedIn() && inChat(chatId);
        allow create: if signedIn() && inChat(chatId)
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /friend_requests/{requestId} {
      // Each disjunct matches one query: received and sent requests.
      allow read, delete: if signedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.senderId == request.auth.uid ||
            resource.data.receiverId == request.auth.uid)
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId;
    }

    // "Active now" / "Active 5m ago". Tiny documents, written only by
    // their owner.
    match /presence/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['online', 'lastActive']);
    }

    match /friendships/{friendshipId} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.auth.uid in request.resource.data.users;
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users;
    }

    match /calls/{callId} {
      // Each disjunct matches one query: the incoming-call listener filters
      // on calleeId, the Calls tab on participants.
      allow read: if signedIn() && (
        request.auth.uid == resource.data.calleeId ||
        request.auth.uid in resource.data.participants);

      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.participants ==
             [request.auth.uid, request.resource.data.calleeId]
        && request.resource.data.status == 'ringing';

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.participants == resource.data.participants;

      match /{candidateCollection}/{candidateId} {
        allow read, write: if signedIn()
          && candidateCollection in ['callerCandidates', 'calleeCandidates']
          && request.auth.uid in
               get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
    }
  }
}
